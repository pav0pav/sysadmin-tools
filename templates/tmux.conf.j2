# mouse scrolling enabled
setw -g mouse on
# don't change colour scheme inside tmux
set-option -sa terminal-features ',xterm-256color:RGB'



# Tmux Plugin Manager
set -g @plugin 'tmux-plugins/tpm'

# Statusline themes plugin
set -g @plugin 'jimeh/tmux-themepack'

# Use a theme
# set -g @themepack 'powerline/default/green'
# set -g @themepack 'basic/double/green'
# set -g @themepack 'powerline/default/cyan'
set -g @themepack 'powerline/block/cyan'
# set -g @themepack 'powerline/double/magenta'

# Initialize TPM and load plugins
run '~/.tmux/plugins/tpm/tpm'

# TPM only sources repos under ~/.tmux/plugins/<name>/ matching @plugin basename
# (e.g. jimeh/tmux-themepack -> ~/.tmux/plugins/tmux-themepack/).
# Ansible clones themepack there; prefix+I installs any other @plugin repos.
